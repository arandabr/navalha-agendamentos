# Neon Postgres (serverless). Copie a connection string do painel do Neon.
DATABASE_URL=postgresql://usuario:senha@ep-seu-host.aws.neon.tech/navalha?sslmode=require

# Asaas: use a chave do SANDBOX (https://sandbox.asaas.com) para testes
ASAAS_API_KEY=seu_token_asaas
# 'sandbox' ou 'production'
ASAAS_MODE=sandbox

# Sessão - use uma string aleatória longa em produção
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Admin inicial (usado no primeiro seed)
ADMIN_PASSWORD=Zehd48@rede3
ADMIN_SALT=navalha-seed-salt
